# --- LLM (OpenAI-compatible endpoint) ---
# Local Ollama. Start the Ollama app first so that :11434 is listening.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:14b
# Ollama serves only 4096 tokens of context by default, which truncates the
# schema prompt. Raise it once per machine, then restart `ollama serve`:
#   [Environment]::SetEnvironmentVariable('OLLAMA_CONTEXT_LENGTH','16384','User')
OLLAMA_CONTEXT_LENGTH=16384

# Strong model for the final single-vs-multi evaluation (Day 9).
# Leave empty while developing locally; set together with LLM_BASE_URL_STRONG.
LLM_MODEL_STRONG=
LLM_BASE_URL_STRONG=
LLM_API_KEY_STRONG=

# --- Database ---
# Read by docker-compose.yml. POSTGRES_PASSWORD only takes effect the first time
# the volume is initialised; changing it later needs an ALTER USER or a fresh
# volume (`docker compose down -v`), and DB_URL_ADMIN must match it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=airdb
# Admin role: used by ingestion + truth_sql only.
DB_URL_ADMIN=postgresql+psycopg2://postgres:change_me_dev_password@127.0.0.1:5432/airdb
# Read-only role: the ONLY connection the agent runtime ever gets (created on Day 1).
DB_URL_RO=postgresql+psycopg2://neuro_ro:neuro_ro_dev_pw@127.0.0.1:5432/airdb

# --- Runtime knobs ---
MAX_TOTAL_STEPS=20
VERIFY_RESERVE=6
SYNTH_RESERVE=3
STATEMENT_TIMEOUT_MS=5000
