# Admin-only credentials for neuro-air-lite.
#
# Copy this file to ~/.neuro-air/admin.env (or anywhere outside the repository)
# and fill in the real values. Override the path with NEURO_ADMIN_ENV.
#
# These keys must NEVER appear in the repo's .env: model-written code can read
# that file through pandas/numpy even when the AST checker blocks `open`.
# Until the Day 10 subprocess, a deliberate absolute-path read is still possible;
# the goal here is to remove the accidental and API-level exposure.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=airdb
DB_URL_ADMIN=postgresql+psycopg2://postgres:change_me_dev_password@127.0.0.1:5432/airdb

# docker compose needs the same POSTGRES_* values:
#   docker compose --env-file ~/.neuro-air/admin.env up -d
